{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "comedy-website",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "comedy-website-db",
      "database_id": "98736ebc-e726-4d98-96f2-1e8a39990094",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "comedy-website-uploads"
    }
  ],
  "vars": {
    "NEXTAUTH_URL": "https://comedy-website.humzah-choudry.workers.dev"
  }
}
